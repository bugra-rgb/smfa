# python scripts/bootstrap.py güvenli parolaları üretir. Bu dosyada gerçek anahtar bulunmaz.
MODE=mock
DATABASE_URL=postgresql+psycopg://factory:CHANGE_ME@postgres:5432/factory
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATA_DIR=./data
SECRET_KEY=
ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:3000
# Optional publicly trusted HTTPS origin for signed media; blank uses PUBLIC_BASE_URL.
MEDIA_BASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
SITE_DOMAIN=
BIND_HOST=127.0.0.1
WEB_PORT=3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
WORKER_CONCURRENCY=2
PROVIDER_CONCURRENCY=2
PROVIDER_LEASE_SECONDS=2100
SCHEDULER_INTERVAL=30
JOB_TIMEOUT=1800
SESSION_HOURS=12

# Google Cloud Web OAuth: Drive; YouTube ayrı proje yoksa Google değerlerini kullanır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUDIT_APPROVED=false

# Instagram Login: Business/Creator hesap; kullanılan desteklenen sürümü girin.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
GRAPH_API_VERSION=
INSTAGRAM_APP_APPROVED=false

# TikTok: kimlik/analitik; bu uygulama için gözetimsiz Direct Post kapalıdır.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Aktif modelleri sağlayıcı konsolunuzdan seçin. Sohbet aboneliği API kredisi değildir.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_VOICE_MODEL=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_VIDEO_MODEL=
VIDEO_PROVIDER_API_KEY=
RUNWAY_VIDEO_MODEL=
VOICE_PROVIDER_API_KEY=

# İşleme deposu yerel paylaşılan volume, ana arşiv Drive'dır.
# Dış S3/R2 ve harici bildirim kanalları bu sürüme bağlanmamıştır.
# İsteğe bağlı güncel USD tarifesi. Boşsa ücretler bilinmiyor olarak kalır.
COST_RATES_JSON={}
